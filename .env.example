# ===========================================
# VARIÁVEIS DE AMBIENTE - Sistema de Prova ADV
# ===========================================
# Copie este arquivo para .env e preencha os valores

# -------------------------------------------
# BANCO DE DADOS (Neon/Postgres)
# -------------------------------------------
# String de conexão do Neon
# Formato: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Obtenha em: https://console.neon.tech → seu projeto → Connection Details
NEON_DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# -------------------------------------------
# AUTENTICAÇÃO INTERNA (n8n → Backend)
# -------------------------------------------
# Chave secreta para autenticar chamadas do orquestrador (n8n)
# IMPORTANTE: Gere uma chave forte com mínimo 32 caracteres
# Exemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=sua-chave-secreta-aqui-minimo-32-caracteres

# -------------------------------------------
# AUTENTICAÇÃO ADMIN (Basic Auth)
# -------------------------------------------
# Use ADMIN_BASIC_AUTH no formato usuario:senha
# Alternativamente, defina ADMIN_BASIC_USER e ADMIN_BASIC_PASSWORD
ADMIN_BASIC_AUTH=admin:sua-senha-forte-aqui
# ADMIN_BASIC_USER=admin
# ADMIN_BASIC_PASSWORD=sua-senha-forte-aqui

# -------------------------------------------
# URLs DA APLICAÇÃO
# -------------------------------------------
# URL pública onde o frontend está hospedado
# Será usada para gerar os magic links
# Exemplo em produção: https://seu-app.netlify.app
# Exemplo em dev: http://localhost:5173
APP_PUBLIC_BASE_URL=http://localhost:5173

# -------------------------------------------
# SEGURANÇA (Opcional)
# -------------------------------------------
# Chave para assinatura HMAC de requests (opcional, para segurança adicional)
# HMAC_SECRET=sua-chave-hmac-aqui

# -------------------------------------------
# MONITORAMENTO (Opcional)
# -------------------------------------------
# DSN do Sentry para captura de erros
# Obtenha em: https://sentry.io → Projeto → Settings → Client Keys
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# -------------------------------------------
# AMBIENTE
# -------------------------------------------
# development | staging | production
NODE_ENV=development
